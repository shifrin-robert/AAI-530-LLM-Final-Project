# DocIntel AI configuration.
# Copy this file to `.env` and fill in the values you need. `.env` is git-ignored: never commit real keys.
# Every setting is optional; the defaults are shown.

# --- Provider and model -------------------------------------------------------
# openai | anthropic | gemini | mock   (mock = offline extractive baseline, no API calls)
DOCINTEL_PROVIDER=openai
# Leave empty to use the provider default (openai: gpt-6-luna, anthropic: claude-haiku-5-5,
# gemini: gemini-3.1-flash-lite). See src/docintel/model_catalog.py for the priced catalog.
DOCINTEL_MODEL=
# Reasoning / thinking effort sent to models that support it (e.g. none, low, medium). Empty = provider default.
DOCINTEL_REASONING_EFFORT=low
# Sampling temperature. Empty = do not send (some reasoning models reject it).
DOCINTEL_TEMPERATURE=

# --- API keys (only the one for your selected provider is needed) -------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Reliability and cost guards -----------------------------------------------
DOCINTEL_REQUEST_TIMEOUT_S=60
DOCINTEL_MAX_RETRIES=2
DOCINTEL_MAX_OUTPUT_TOKENS=4000
DOCINTEL_MAX_REQUESTS_PER_SESSION=200

# --- Upload limits ---------------------------------------------------------------
DOCINTEL_MAX_FILE_MB=20
DOCINTEL_MAX_DOCUMENTS=10
DOCINTEL_MAX_PAGES_PER_DOCUMENT=300
DOCINTEL_MAX_TOTAL_PAGES=1000

# --- Retrieval -------------------------------------------------------------------
DOCINTEL_CHUNK_SIZE=1000
DOCINTEL_CHUNK_OVERLAP=150
# bm25 | char_ngram | hybrid
DOCINTEL_RETRIEVER=hybrid
DOCINTEL_TOP_K=8
DOCINTEL_CONTEXT_TOKEN_BUDGET=6000

# --- Prompts ---------------------------------------------------------------------
# v1 (initial baseline) | v2 (revised, default)
DOCINTEL_QA_PROMPT_VERSION=v2
